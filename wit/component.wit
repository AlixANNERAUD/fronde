package jarvis:component@0.1.0;

/// Non-secret settings the host chooses for a component (URLs, user names, time zone). Credentials
/// never go through here: the host adds them to outgoing requests itself.
interface settings {
  get: func(key: string) -> option<string>;
}

interface tools {
  record tool {
    name: string,
    description: string,
    /// JSON Schema of the arguments, as JSON text.
    input-schema: string,
    /// Hidden from the tool list; found through search_tools.
    deferred: bool,
  }

  record tool-output {
    /// JSON text.
    value: string,
    next: option<string>,
    is-error: bool,
  }

  list-tools: func() -> list<tool>;
  /// `arguments` is JSON text.
  call-tool: func(name: string, arguments: string) -> tool-output;
}

/// A component that brings tools to the hub.
world tool {
  import settings;
  export tools;
}
